# Токен бота из Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=вставьте_сюда_токен

# --- LLM ---
OLLAMA_MODEL=huihui_ai/gemma-4-abliterated:latest
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_THREAD=16
# Контекст модели (токены). Не задавать — Ollama возьмёт полный обучающий
# контекст модели (у qwen3 40960), KV-кэш на который не влезает в VRAM
# вместе с весами, и большая часть слоёв уходит на CPU (медленно/зависания).
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
LLM_MAX_TOKENS=512
# Таймаут запроса к Ollama (сек) — чтобы зависший запрос не тормозил всё навсегда.
# Если TTS_ENGINE=qwen, Ollama и Qwen-TTS делят один GPU — под нагрузкой генерация
# может ощутимо тормозить, и слишком тугой таймаут обрежет ответ раньше
# естественного завершения. 60с — запас с учётом этой конкуренции за GPU.
OLLAMA_TIMEOUT_SEC=60

# --- Распознавание речи ---
WHISPER_MODEL_SIZE=small
WHISPER_CPU_THREADS=8

# --- Голос ---
# qwen — Ono_Anna (GPU, отдельное окружение), silero — запасной CPU-движок
TTS_ENGINE=qwen
QWEN_SPEAKER=Ono_Anna
QWEN_RUNTIME=faster
QWEN_PYTHON=qwen_tts_trial/faster_env/Scripts/python.exe
QWEN_MODEL_DIR=qwen_tts_trial/weights/custom
QWEN_TIMEOUT_SEC=180
QWEN_MAX_TOKENS=768

# --- Голос (Silero, локально): xenia/baya/kseniya жен., aidar/eugene муж. ---
SILERO_SPEAKER=baya
SILERO_CPU_THREADS=4

# --- Персонаж и память ---
CHARACTER_FILE=character.txt
MEMORY_FILE=memory.json

# --- Тонкая настройка голосового поведения ---
# Пауза (сек), после которой фраза считается законченной
SILENCE_LIMIT_SEC=0.8
# Требовать обращения по имени перед голосовым ответом: true/false
REQUIRE_WAKE_WORD=false
# Допустимые обращения по имени, через запятую; регистр не важен
WAKE_WORDS=ари,ори,ария,эри,арии,арию,арией,аре,а ри,айре
# Минимальная длительность фразы для отправки в распознавание (сек)
MIN_UTTERANCE_SEC=0.4
# Через сколько секунд тишины в канале бот сам заговорит на случайную тему
IDLE_CHATTER_SEC=120
IDLE_SONG_SEC=300
